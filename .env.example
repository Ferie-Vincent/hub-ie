APP_NAME="Hub Import-Export 2026"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données (PostgreSQL 16) ──────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hub_ie
DB_USERNAME=hub
DB_PASSWORD=

# ── Sessions / Cache / Queues (Redis 7) ──────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail (SMTP — local Mailpit / prod Brevo/Postmark) ────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@hubimportexport.ci"
MAIL_FROM_NAME="Hub Import-Export 2026"
MAIL_REPLY_TO="contact@dgce.ci"

# ── Stockage fichiers (MinIO / S3-compatible) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=hub-ie
AWS_URL=http://localhost:9000
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=

# ── Hub Import-Export — Paramètres métier ────────────────────────────────
HUB_APPLICATION_OPENS_AT="2026-04-01 00:00:00"
HUB_APPLICATION_CLOSES_AT="2026-05-15 23:59:59"
HUB_EVENT_STARTS_AT="2026-06-22 09:00:00"
HUB_EVENT_ENDS_AT="2026-06-25 18:00:00"
HUB_TARGET_AUDITORS=180
HUB_QUOTA_WOMEN_MIN_PCT=50
HUB_QUOTA_YOUTH_MIN_PCT=40
HUB_QUOTA_YOUTH_MAX_AGE=35
HUB_TIMEZONE="Africa/Abidjan"

VITE_APP_NAME="${APP_NAME}"
